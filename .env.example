# Runtime environment: development, testing, or production
ENV=development

# Real provider credentials; missing keys are reported as not configured
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
# URLhaus shares the abuse.ch key with ThreatFox; leave blank to reuse it
URLHAUS_API_KEY=
THREATFOX_API_KEY=
AI_API_KEY=

# Application settings
DB_PATH=./data/cyberip.db
HTTP_TIMEOUT=10
DNS_TIMEOUT=3
CACHE_TTL=3600
ANALYSIS_TIMEOUT=15
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
